<section xmlns:tal="http://xml.zope.org/namespaces/tal"
         class="derico-page-header">
  <!--! `.derico-page-header`, never Aurora's `.block-derico-page-header`
       wrapper stamp: the wrapper is a different box on each surface (hero
       ticket 07), and the block owns its own root so one sheet measures the
       same on both. The tree below matches PageHeader.tsx class for class.

       The kicker is the block's; the title and the description are the
       page's fields (see pageheader.py). Each element renders only with
       text, as the TSX omits an empty slot. -->
  <div class="page-header__grid">
    <div>
      <p class="page-context"
         tal:condition="view/kicker"
         tal:content="view/kicker">kicker</p>
      <!--! No `lang` attribute: `hyphens: auto` reads the page language,
           which main_template already sets. -->
      <h1 class="documentFirstHeading"
          tal:condition="view/title"
          tal:content="view/title">title</h1>
    </div>
    <p class="documentDescription lede"
       tal:condition="view/description"
       tal:content="view/description">description</p>
  </div>
</section>
