<?xml version="1.0" encoding="UTF-8"?>
<metadata>
  <version>1011</version>
  <dependencies>
    <dependency>profile-plone.app.registry:default</dependency>
    <!-- The brand blocks' host. A Python dependency does not install a
         profile, and without Blicca's profile the IAuroraBlockAddon record
         below has no reader, the editor has no @@aurora-edit and the hero
         has nothing to mount in. Above Clara because it is the deeper
         requirement: Clara is the look, Blicca is the machinery. -->
    <dependency>profile-plone.blicca.auroraeditor:default</dependency>
    <!-- derico is a values-only theme layered on Clara: installing derico
         installs Clara, which in turn installs plone.pageletlayout: the
         rendering machinery, the markup contract, the primitives, and the
         plone token defaults. derico then re-points the ladder. -->
    <dependency>profile-plonetheme.clara:default</dependency>
    <!-- The generic fragment block. derico ships its `snippets/` corpus as
         fragments for it (fragments.py, bundle-src/src/fragments/), and a
         provider without the block that reads them is dead weight: the
         picker only exists once the add-on's own record and browser layer
         are installed. Python dependency plus profile dependency, the same
         pairing Blicca gets above. -->
    <dependency>profile-collective.fragmentsblock:default</dependency>
    <!-- The Promo block, the same pairing once more. Its node is
         authored on derico's pages, and the add-on's own profile is
         what puts the record, the browser layer and the renderer
         behind it; a Python dependency installs none of them. -->
    <dependency>profile-derico.blicca.promoblock:default</dependency>
  </dependencies>
</metadata>
