<?xml version="1.0" encoding="UTF-8"?>
<object>
  <!-- The contact band joins the whole-body layout manager's order directly
       before the first footer row, so it renders below the page and below
       Clara's sub-navigation, exactly where every mockup page puts it.

       insert-before the FOOTER, not insert-after the sub-navigation: the
       sub-navigation renders nothing on a page without children, and anchoring
       to an element that is often absent would leave the band's position
       depending on the page. The footer rows are on every page.

       insert-before, not a restated order: plone.pageletlayout owns the
       canonical sequence (layout.ELEMENTS, pinned by its own parity test) and
       this file must not fork it. The importer starts from whatever order is
       stored, removes the name if present and re-inserts it at the anchor —
       so this is additive, idempotent, and survives the base package growing
       new elements.

       CSS `order` does the rest of the work in the footer itself: Clara gives
       the three footer rows order 1/2/3 and everything else stays at 0, so the
       band precedes all three whichever of them the importer anchored to. -->
  <order manager="plone.pageletlayout.layout" skinname="Plone Default">
    <viewlet name="plonetheme.derico.contactband"
             insert-before="plone.pageletlayout.copyright" />
  </order>
</object>
