<?xml version="1.0" encoding="UTF-8"?>
<registry>

  <!-- Unlayered token overrides on top of Clara; beats Clara's `@layer tokens`
       regardless of load order. No `expression`: Clara styles every page. -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-derico">
    <value key="csscompilation">++resource++plonetheme.derico/derico.css</value>
    <value key="depends">plonetheme-clara</value>
    <value key="load_defer">True</value>
    <value key="expression"></value>
    <value key="enabled">True</value>
  </records>

  <!-- One record per block: `loadBlockAddons` calls install() once per record,
       so a shared record would defeat the per-block `enabled` switch. Not a
       plone.bundles record: that emits a classic script, missing the import
       map, and loads a second React. -->
  <records interface="plone.blicca.auroraeditor.interfaces.IAuroraBlockAddon"
           prefix="plone.blicca.auroraeditor.blockaddons/plonetheme.derico.hero">
    <value key="bundle">++plone++plonetheme.derico.blocks/hero.js</value>

    <!-- The floor the block needs, not the host's version: a mismatch silently
         drops the block from the slash menu. -->
    <value key="block_api">1.0</value>

    <!-- Lib mode emits one stylesheet per build, shared by every block. -->
    <value key="css">++plone++plonetheme.derico.blocks/blocks.css</value>

    <value key="types">
      <element>derico-hero</element>
    </value>

    <!-- A permission title, not the ZCML id. The bundle still loads for
         everyone so existing heroes render for all editors. -->
    <value key="permission">plonetheme.derico: Insert Brand Block</value>

    <value key="enabled">True</value>
    <value key="weight">100</value>
  </records>

  <!-- No `permission` on purpose: every page opens with a header, and the
       page's own editor inserts it. -->
  <records interface="plone.blicca.auroraeditor.interfaces.IAuroraBlockAddon"
           prefix="plone.blicca.auroraeditor.blockaddons/plonetheme.derico.pageheader">
    <value key="bundle">++plone++plonetheme.derico.blocks/pageheader.js</value>
    <value key="block_api">1.0</value>
    <value key="css">++plone++plonetheme.derico.blocks/blocks.css</value>
    <value key="types">
      <element>derico-page-header</element>
    </value>
    <value key="enabled">True</value>
    <value key="weight">110</value>
  </records>

  <!-- Fragment provider, not a block: a record is the only way a bundle loads
       into the editor. No `types`, `permission` or `css`: the fragment block's
       own record gates inserts and snippets.css styles the fragments. -->
  <records interface="plone.blicca.auroraeditor.interfaces.IAuroraBlockAddon"
           prefix="plone.blicca.auroraeditor.blockaddons/plonetheme.derico.fragments">
    <value key="bundle">++plone++plonetheme.derico.blocks/fragments.js</value>
    <value key="block_api">1.0</value>
    <value key="types"/>
    <value key="enabled">True</value>
    <value key="weight">120</value>
  </records>

  <!-- A theme bundle, not block-record `css`: the sheet carries its own
       `@scope` wrap (see static/snippets.css). -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-derico-snippets">
    <value key="csscompilation">++resource++plonetheme.derico/snippets.css</value>
    <value key="depends">plonetheme-derico</value>
    <value key="load_defer">True</value>
    <value key="expression"></value>
    <value key="enabled">True</value>
  </records>

  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-derico-header">
    <value key="csscompilation">++resource++plonetheme.derico/header.css</value>
    <value key="depends">plonetheme-derico</value>
    <value key="load_defer">True</value>
    <value key="expression"></value>
    <value key="enabled">True</value>
  </records>

  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-derico-footer">
    <value key="csscompilation">++resource++plonetheme.derico/footer.css</value>
    <value key="depends">plonetheme-derico</value>
    <value key="load_defer">True</value>
    <value key="expression"></value>
    <value key="enabled">True</value>
  </records>

  <!-- Loads everywhere with media="all"; its single `@media print` keeps it
       off screen. -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-derico-print">
    <value key="csscompilation">++resource++plonetheme.derico/print.css</value>
    <value key="depends">plonetheme-derico</value>
    <value key="load_defer">True</value>
    <value key="expression"></value>
    <value key="enabled">True</value>
  </records>

  <!-- The header's search is Clara's toggle; header.css styles it. -->
  <record name="plonetheme.clara.search_on_demand">
    <value>True</value>
  </record>

  <!-- Appended (`purge="false"`), never replacing: other code hardcodes the
       stock scale names. 2600 covers a 2560 desktop. Picture variants are a
       JSONField GS cannot express; see ensure_hero_variants(). -->
  <record name="plone.allowed_sizes">
    <value purge="false">
      <element>enormous 2600:65536</element>
    </value>
  </record>

</registry>
