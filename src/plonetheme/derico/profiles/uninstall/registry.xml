<?xml version="1.0" encoding="UTF-8"?>
<registry>

  <!-- Remove the bundle records registered by the default profile, so no
       orphaned bundle keeps loading a stylesheet after uninstall. One node
       per bundle, and that is not redundancy: `remove` expands to one
       `<value purge>` per field of the named interface under the given
       prefix, so a prefix removes exactly its own record and never a longer
       one that happens to start with the same characters. -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-derico"
           remove="true" />
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-derico-snippets"
           remove="true" />
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/plonetheme-derico-header"
           remove="true" />

  <!-- Same for the block records: an orphaned IAuroraBlockAddon record would
       keep @@aurora-edit trying to load a bundle whose ZCML is gone, and the
       hero would keep appearing in the slash menu of a site that can no
       longer render it. -->
  <records interface="plone.blicca.auroraeditor.interfaces.IAuroraBlockAddon"
           prefix="plone.blicca.auroraeditor.blockaddons/plonetheme.derico.hero"
           remove="true" />

  <!-- DELIBERATELY ASYMMETRIC, and not an oversight to be tidied up: neither
       the `enormous` scale rung nor the two `hero-*` picture variants is
       removed here (hero ticket 05 §5, matching how Blicca never removes its
       own `fullwidth`). Removing a scale that content elsewhere has since
       come to reference is worse than leaving a harmless extra rung in the
       ladder; the bundle records above have no such second reader. -->

</registry>
