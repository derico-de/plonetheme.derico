"Language-Team: Plone <dev@plone.org>\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"Language-Code: de\n"
"Language-Name: Deutsch\n"
"Preferred-Encodings: utf-8 latin1\n"
"Domain: widgets\n"

#. Opens pat-livesearch's summary line, before the number of results.
msgid "found"
msgstr "Gefunden:"

#. Closes pat-livesearch's summary line, after the number of results.
msgid "results"
msgstr "Treffer"
