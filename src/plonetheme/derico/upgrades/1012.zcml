<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1012"
      title="plonetheme.derico: upgrade to 1012"
      directory="1012"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1011"
      destination="1012"
      profile="plonetheme.derico:default">

    <!-- Declarative, as 1010 was for the header: the footer adds ONE thing
         to an existing site — a bundle record — and the upgrade profile
         carries exactly the one file that declares it. The rules themselves
         are a stylesheet, live the moment the code is; the record is what
         makes a page request it.

         No `reload_gs_profile`: that re-imports every step of the DEFAULT
         profile, including the ones that write a site logo and a
         picture-variant ladder an administrator may have edited since.

         `import_steps` narrows it once more, as in 1010: without them
         GenericSetup runs every registered import step against this profile,
         and a step whose file is merely absent still runs its handler. -->
    <genericsetup:upgradeDepends
        title="Add the footer bundle"
        description="Register the footer stylesheet bundle on sites that predate it"
        import_profile="plonetheme.derico.upgrades:1012"
        import_steps="plone.app.registry"
        />

  </genericsetup:upgradeSteps>

</configure>
