<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1005"
      title="plonetheme.derico: upgrade to 1005"
      directory="1005"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1004"
      destination="1005"
      profile="plonetheme.derico:default">

    <genericsetup:upgradeStep
        title="Install collective.fragmentsblock"
        description="Install the fragment block add-on on sites that predate the profile dependency"
        handler=".v1005.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1005"
        import_profile="plonetheme.derico.upgrades:1005"
        />

  </genericsetup:upgradeSteps>

</configure>
