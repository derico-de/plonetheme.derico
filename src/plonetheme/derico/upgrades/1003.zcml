<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1003"
      title="plonetheme.derico: upgrade to 1003"
      directory="1003"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1002"
      destination="1003"
      profile="plonetheme.derico:default">

    <genericsetup:upgradeStep
        title="Register derico as a fragment provider"
        description="Register the fragments bundle record for collective.fragmentsblock"
        handler=".v1003.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1003"
        import_profile="plonetheme.derico.upgrades:1003"
        />

  </genericsetup:upgradeSteps>

</configure>
