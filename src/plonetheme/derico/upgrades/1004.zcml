<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1004"
      title="plonetheme.derico: upgrade to 1004"
      directory="1004"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1003"
      destination="1004"
      profile="plonetheme.derico:default">

    <genericsetup:upgradeStep
        title="Retire the Derico Snippet block"
        description="Convert every stored derico-snippet node into a fragment block"
        handler=".v1004.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1004"
        import_profile="plonetheme.derico.upgrades:1004"
        />

  </genericsetup:upgradeSteps>

</configure>
