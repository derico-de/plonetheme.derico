<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1018"
      title="plonetheme.derico: upgrade to 1018"
      directory="1018"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1017"
      destination="1018"
      profile="plonetheme.derico:default">

    <genericsetup:upgradeDepends
        title="Register the AVIF settings of the imaging control panel"
        description="IImagingSchema got avif_mode, avif_quality and avif_speed; re-register it so existing sites get the records."
        import_profile="plonetheme.derico.upgrades:1018"
        import_steps="plone.app.registry"
        />

  </genericsetup:upgradeSteps>

</configure>
