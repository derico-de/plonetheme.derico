<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1002"
      title="plonetheme.derico: upgrade to 1002"
      directory="1002"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1001"
      destination="1002"
      profile="plonetheme.derico:default">

    <genericsetup:upgradeStep
        title="Install the Derico Snippet brand block"
        description="Register the snippet block record and the snippets stylesheet bundle"
        handler=".v1002.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1002"
        import_profile="plonetheme.derico.upgrades:1002"
        />

  </genericsetup:upgradeSteps>

</configure>
