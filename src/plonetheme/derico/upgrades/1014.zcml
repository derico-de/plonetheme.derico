<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1014"
      title="plonetheme.derico: upgrade to 1014"
      directory="1014"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1013"
      destination="1014"
      profile="plonetheme.derico:default">

    <!-- Declarative, as 1012 and 1013 were: the page header adds ONE thing
         to an existing site, a block record, and the upgrade profile
         carries exactly the one file that declares it. The renderer and the
         bundle are code, live the moment the package is; the record is what
         makes @@aurora-edit load the bundle.

         No `reload_gs_profile`, and `import_steps` narrowed to the registry,
         for the reasons 1013 states. -->
    <genericsetup:upgradeDepends
        title="Add the Derico Page Header brand block"
        description="Register the page header block record on sites that predate it"
        import_profile="plonetheme.derico.upgrades:1014"
        import_steps="plone.app.registry"
        />

  </genericsetup:upgradeSteps>

</configure>
