<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1025"
      title="plonetheme.derico: upgrade to 1025"
      directory="1025"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1024"
      destination="1025"
      profile="plonetheme.derico:default">

    <genericsetup:upgradeStep
        title="Run Blicca's pending upgrades"
        description="Blicca's upgrade 1006 creates the block_backgrounds record the next step writes to."
        handler=".v1025.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Register the copper block background"
        description="Offer copper next to Blicca's grey, accent and dark in the block_backgrounds record."
        import_profile="plonetheme.derico.upgrades:1025"
        import_steps="plone.app.registry"
        />

  </genericsetup:upgradeSteps>

</configure>
