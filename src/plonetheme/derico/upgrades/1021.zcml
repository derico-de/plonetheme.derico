<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="plonetheme.derico">

  <genericsetup:registerProfile
      name="1021"
      title="plonetheme.derico: upgrade to 1021"
      directory="1021"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1020"
      destination="1021"
      profile="plonetheme.derico:default">

    <genericsetup:upgradeStep
        title="Drop the retired block_api field"
        description="block_api is retired (ADR 0024 in plone.blicca.auroraeditor); delete the theme&#39;s own orphan block_api records if any are left."
        handler=".v1021.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
