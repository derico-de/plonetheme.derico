<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plonetheme.derico">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />
  <include package=".browser" />

  <!-- The token override sheet and the brand mark, served at
       ++resource++plonetheme.derico/ and linked by the bundle registered in
       profiles/default/registry.xml. This is the whole theme payload —
       derico ships no fonts (Clara self-hosts the same Literata / Source
       Sans 3 pair) and no compiled Bootstrap. -->
  <browser:resourceDirectory
      name="plonetheme.derico"
      directory="static"
      />

  <!-- The brand blocks' editor bundles, built from bundle-src/ and committed.
       A SECOND directory, and `++plone++` rather than `++resource++`: the
       contract's cache-buster names `++plone++` (blockaddons.py:170), and
       double-registering one directory under both directives would give every
       file two public URLs — two URLs for one JS module is exactly the
       duplicate-instance failure the contract exists to prevent (ticket 04 §3).
       Reserved entirely for build output; `emptyOutDir` wipes it on every
       build, so nothing hand-written may live there. -->
  <plone:static
      name="plonetheme.derico.blocks"
      type="plone"
      directory="static-blocks"
      />

  <!-- derico as a fragment provider: the `snippets/` corpus, published for
       collective.fragmentsblock's generic fragment block. Global, not
       per-site — the corpus is package files, and the fragment block's own
       per-site registry record is what decides whether anything can read
       it. See fragments.py; the editor half is the `fragments` bundle
       registered in profiles/default/registry.xml. -->
  <utility
      name="plonetheme.derico"
      provides="collective.fragmentsblock.interfaces.IFragmentsProvider"
      component=".fragments.provider"
      />

  <genericsetup:registerProfile
      name="default"
      title="Plonetheme Derico"
      description="Jahresringe — the derico.de brand, as a token layer on Clara"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Plonetheme Derico (uninstall)"
      description="Uninstalls plonetheme.derico"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:importStep
      name="plonetheme.derico-uninstall"
      title="Plonetheme Derico uninstall"
      description="Uninstall plonetheme.derico"
      handler="plonetheme.derico.setuphandlers.uninstall"
      />

  <!-- Keep the uninstall profile out of the Add-ons control panel. -->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="plonetheme.derico-hiddenprofiles"
      />


  <include package=".upgrades" />

</configure>
